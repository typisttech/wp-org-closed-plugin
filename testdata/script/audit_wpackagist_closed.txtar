exec composer config repositories.wp-org-closed-plugin path $PWD
exec composer install

! exec composer audit --format=json

[composer:2.11] cmp stdout golden.out
[!composer:2.11] cmp stdout golden.v2.10.out

-- composer.json --
{
    "name": "test/example",
    "version": "0.0.1",
    "require": {
        "typisttech/wp-org-closed-plugin": "@dev",
        "wpackagist-plugin/wp-mobi": "*"
    },
    "repositories": {
        "wpackagist": {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "typisttech/wp-org-closed-plugin": true
        }
    }
}

-- golden.out --
{
    "advisories": [],
    "abandoned": {
        "wpackagist-plugin/wp-mobi": null
    },
    "filter": [],
    "cooldown": []
}
-- golden.v2.10.out --
{
    "advisories": [],
    "abandoned": {
        "wpackagist-plugin/wp-mobi": null
    },
    "filter": []
}
